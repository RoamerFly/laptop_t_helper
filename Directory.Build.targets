<Project>
  <!-- The referenced LibreHardwareMonitor source generator requires a concrete
       architecture. Keep the upstream tree untouched and force its net10 build
       to the application's supported architecture from the repository root. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LibreHardwareMonitorLib' and '$(TargetFramework)' == 'net10.0'">
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
</Project>
