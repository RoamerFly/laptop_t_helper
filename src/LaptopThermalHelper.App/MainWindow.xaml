<Window x:Class="LaptopThermalHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LaptopThermalHelper.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:LaptopThermalHelper.App.Views"
        Title="笔记本温控助手"
        Width="1280"
        Height="720"
        MinWidth="1280"
        MinHeight="720"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <converters:ThermalLevelToBrushConverter x:Key="LevelBrushConverter" />
  </Window.Resources>

  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Viewbox Stretch="Uniform">
      <Grid Width="1536" Height="1024" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="972" />
          <RowDefinition Height="52" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="278" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="86" />
              <RowDefinition Height="*" />
              <RowDefinition Height="260" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="62" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0"
                      Width="34"
                      Height="38"
                      Margin="18,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{DynamicResource AccentBrush}"
                      CornerRadius="9">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="✓" />
              </Border>
              <TextBlock Grid.Column="1"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Text="笔记本温控助手"
                         VerticalAlignment="Center" />
              <Border Grid.Column="2"
                      Width="52"
                      Height="27"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="13"
                      VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Text="v0.1.0" />
              </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,11,0,0">
              <RadioButton IsChecked="True" Style="{StaticResource NavButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="40" FontFamily="Segoe Fluent Icons" FontSize="22" Text="&#xE80F;" />
                  <TextBlock FontSize="17" Text="总览" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="40" FontFamily="Segoe UI Symbol" FontSize="22" Text="♨" />
                  <TextBlock FontSize="17" Text="温度监控" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="40" FontFamily="Segoe UI Symbol" FontSize="22" Text="✺" />
                  <TextBlock FontSize="17" Text="风扇控制" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="40" FontFamily="Segoe Fluent Icons" FontSize="22" Text="&#xE9D2;" />
                  <TextBlock FontSize="17" Text="性能模式" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="40" FontFamily="Segoe Fluent Icons" FontSize="22" Text="&#xE713;" />
                  <TextBlock FontSize="17" Text="设置" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="40" FontFamily="Segoe Fluent Icons" FontSize="22" Text="&#xE9D5;" />
                  <TextBlock FontSize="17" Text="日志" />
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource NavButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="40" FontFamily="Segoe Fluent Icons" FontSize="22" Text="&#xE946;" />
                  <TextBlock FontSize="17" Text="关于" />
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <Grid Grid.Row="2" Margin="20,0,18,16">
              <Grid.RowDefinitions>
                <RowDefinition Height="204" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="🛡  自动降温" VerticalAlignment="Center" />
                    <Border Width="44" Height="24" HorizontalAlignment="Right" Background="{DynamicResource GaugeTrackBrush}" CornerRadius="12">
                      <Ellipse Width="19" Height="19" Margin="3,0,0,0" HorizontalAlignment="Left" Fill="White" />
                    </Border>
                  </Grid>
                  <Grid Grid.Row="1">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="模式：仅监测" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource BlueBrush}" Text="设置" VerticalAlignment="Center" />
                  </Grid>
                  <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />
                  <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource TextSecondaryBrush}" Text="上次触发：无" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="当前状态：待命中" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Text="{Binding RuntimeText, StringFormat=已运行： {0}}" />
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="160" />
            <RowDefinition Height="470" />
            <RowDefinition Height="342" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="18,26,22,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="318" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="28,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="62" Background="{Binding SystemLevel, Converter={StaticResource LevelBrushConverter}}" CornerRadius="16" Opacity="0.92">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="35" FontWeight="Bold" Foreground="#08230D" Text="✓" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="27" FontWeight="SemiBold" Text="整机状态：" />
                    <TextBlock FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{Binding SystemLevel, Converter={StaticResource LevelBrushConverter}}"
                               Text="{Binding SystemStatus}" />
                  </StackPanel>
                  <TextBlock Margin="0,5,0,0" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SystemMessage}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border Width="50" Height="50" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="25">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{DynamicResource BlueBrush}" Text="&#xE9D2;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock FontSize="17" FontWeight="SemiBold" Text="当前模式：均衡模式" />
                  <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Fn + Q 可切换性能模式" />
                </StackPanel>
                <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource TextSecondaryBrush}" Text="&#xE70D;" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="1" Margin="18,0,22,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="18" />
              <ColumnDefinition />
              <ColumnDefinition Width="18" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <views:HardwareCardView Grid.Column="0" DataContext="{Binding Cpu}" />
            <views:HardwareCardView Grid.Column="2" DataContext="{Binding Gpu}" />
            <views:HardwareCardView Grid.Column="4" DataContext="{Binding Storage}" />
          </Grid>

          <Grid Grid.Row="2" Margin="18,0,22,30">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.05*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="1.17*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="44" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="48" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="整机状态" />
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Width="102" Height="102" BorderBrush="{Binding SystemLevel, Converter={StaticResource LevelBrushConverter}}" BorderThickness="12" CornerRadius="51" Opacity="0.85">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="45" FontWeight="Bold" Foreground="{Binding SystemLevel, Converter={StaticResource LevelBrushConverter}}" Text="✓" />
                  </Border>
                  <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="CPU温度" />
                    <TextBlock Grid.Column="1" Foreground="{Binding Cpu.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Cpu.LevelText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Cpu.CurrentText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Style="{StaticResource MetricLabelStyle}" Text="GPU温度" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{Binding Gpu.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Gpu.LevelText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Gpu.CurrentText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Style="{StaticResource MetricLabelStyle}" Text="SSD温度" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{Binding Storage.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Storage.LevelText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Storage.CurrentText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Style="{StaticResource MetricLabelStyle}" Text="系统负载" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource SuccessBrush}" Text="正常" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Cpu.LoadText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Style="{StaticResource MetricLabelStyle}" Text="内存使用" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource SuccessBrush}" Text="正常" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="45%" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="9" Padding="12,0">
                  <TextBlock VerticalAlignment="Center">
                    <Run FontWeight="Bold" Foreground="{Binding SystemLevel, Converter={StaticResource LevelBrushConverter}}" Text="太棒了！ " />
                    <Run Foreground="{DynamicResource TextSecondaryBrush}" Text="所有硬件温度都在正常范围内。" />
                  </TextBlock>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="44" />
                  <RowDefinition Height="30" />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="温度预警" />
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="硬件" />
                  <TextBlock Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" Text="当前温度" />
                  <TextBlock Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}" Text="状态" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="88" /><ColumnDefinition Width="68" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock FontSize="17" Text="CPU" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" FontSize="17" Text="{Binding Cpu.CurrentText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Foreground="{Binding Cpu.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Cpu.LevelText}" VerticalAlignment="Center" />
                  <Border Grid.Column="3" Height="9" CornerRadius="5" VerticalAlignment="Center">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#36CC88" Offset="0" /><GradientStop Color="#F2CF3A" Offset="0.42" /><GradientStop Color="#FF8A22" Offset="0.7" /><GradientStop Color="#FF3445" Offset="1" /></LinearGradientBrush></Border.Background>
                  </Border>
                </Grid>
                <Grid Grid.Row="3" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="88" /><ColumnDefinition Width="68" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock FontSize="17" Text="GPU" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" FontSize="17" Text="{Binding Gpu.CurrentText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Foreground="{Binding Gpu.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Gpu.LevelText}" VerticalAlignment="Center" />
                  <Border Grid.Column="3" Height="9" CornerRadius="5" VerticalAlignment="Center">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#36CC88" Offset="0" /><GradientStop Color="#F2CF3A" Offset="0.42" /><GradientStop Color="#FF8A22" Offset="0.7" /><GradientStop Color="#FF3445" Offset="1" /></LinearGradientBrush></Border.Background>
                  </Border>
                </Grid>
                <Grid Grid.Row="4" Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="88" /><ColumnDefinition Width="68" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock FontSize="17" Text="SSD" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" FontSize="17" Text="{Binding Storage.CurrentText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Foreground="{Binding Storage.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Storage.LevelText}" VerticalAlignment="Center" />
                  <Border Grid.Column="3" Height="9" CornerRadius="5" VerticalAlignment="Center">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#36CC88" Offset="0" /><GradientStop Color="#F2CF3A" Offset="0.42" /><GradientStop Color="#FF8A22" Offset="0.7" /><GradientStop Color="#FF3445" Offset="1" /></LinearGradientBrush></Border.Background>
                  </Border>
                </Grid>
                <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <TextBlock Margin="0,0,24,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="● 正常" />
                  <TextBlock Margin="0,0,24,0" Foreground="{DynamicResource WarningBrush}" Text="● 偏高" />
                  <TextBlock Margin="0,0,24,0" Foreground="{DynamicResource HighBrush}" Text="● 过高" />
                  <TextBlock Foreground="{DynamicResource CriticalBrush}" Text="● 严重过热" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="44" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="快捷操作" />
                <StackPanel Grid.Row="1">
                  <Button Style="{StaticResource QuickButtonStyle}">
                    <Grid><TextBlock Text="⚙  打开温控设置" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid>
                  </Button>
                  <Button Style="{StaticResource QuickButtonStyle}" Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleBrush}" Foreground="{DynamicResource PurpleTextBrush}">
                    <Grid><TextBlock Text="⚖  切换性能模式" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid>
                  </Button>
                  <Button Command="{Binding ExportHistoryCommand}"
                          ToolTip="{Binding LastHistoryExportPath}"
                          Style="{StaticResource QuickButtonStyle}"
                          Background="{DynamicResource InfoSoftBrush}"
                          BorderBrush="{DynamicResource InfoBrush}"
                          Foreground="{DynamicResource InfoTextBrush}">
                    <Grid><TextBlock Text="{Binding HistoryExportActionText}" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid>
                  </Button>
                  <Button Style="{StaticResource QuickButtonStyle}" Background="{DynamicResource CriticalSoftBrush}" BorderBrush="{DynamicResource CriticalBrush}" Foreground="{DynamicResource CriticalTextBrush}">
                    <Grid><TextBlock Text="↶  一键恢复默认设置" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <Grid Height="46" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ThemeButton" Width="95" Margin="0,7,15,0" Height="30" Click="ThemeButton_Click" Content="☾  深色" Style="{StaticResource WindowButtonStyle}" FontFamily="{StaticResource AppFont}" FontSize="13" />
              <Button Click="MinimizeButton_Click" Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" />
              <Button Click="MaximizeButton_Click" Content="&#xE922;" Style="{StaticResource WindowButtonStyle}" />
              <Button Click="CloseButton_Click" Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}" />
            </StackPanel>
          </Grid>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid Margin="34,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="{DynamicResource TextSecondaryBrush}" Text="▦  Windows 11 专业版  64位" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Text="▣  Lenovo 拯救者 Y9000P 2021" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" Text="▣  电源模式：平衡" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Foreground="{DynamicResource TextSecondaryBrush}" Text="▣  电量：98%" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" Text="♣  已连接电源" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</Window>
