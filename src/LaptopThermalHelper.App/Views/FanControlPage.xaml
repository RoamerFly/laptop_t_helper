<UserControl x:Class="LaptopThermalHelper.App.Views.FanControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,24,24">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="风扇控制" />
      <TextBlock Margin="0,5,0,18" Foreground="{DynamicResource TextSecondaryBrush}" Text="第一版仅展示硬件可提供的转速信息，不写入 EC、不修改 BIOS，也不指定风扇 RPM。" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="76" /><RowDefinition Height="50" /></Grid.RowDefinitions>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前可读风扇信息" />
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Margin="0,0,12,0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="14"><StackPanel><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="CPU 风扇" /><TextBlock Margin="0,5,0,0" FontSize="21" FontWeight="SemiBold" Text="{Binding Dashboard.Cpu.FanText}" /></StackPanel></Border><Border Grid.Column="1" Margin="0,0,12,0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="14"><StackPanel><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="GPU 风扇" /><TextBlock Margin="0,5,0,0" FontSize="21" FontWeight="SemiBold" Text="{Binding Dashboard.Gpu.FanText}" /></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="14"><StackPanel><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="EC 写入" /><TextBlock Margin="0,5,0,0" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" Text="不支持" /></StackPanel></Border></Grid>
              <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="若硬件未公开转速，界面显示“未开放”，不会用 0 RPM 替代。" />
            </Grid>
          </Border>
          <Border Style="{StaticResource CardStyle}" Padding="20">
            <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition /><RowDefinition Height="44" /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="设备固件自动控制" /><TextBlock Grid.Row="1" TextWrapping="Wrap" LineHeight="26" Foreground="{DynamicResource TextSecondaryBrush}" Text="风扇曲线由设备固件和当前系统策略决定。本程序不会模拟厂商快捷键，也不会调用 EC、BIOS、厂商专有接口或未知风扇控制接口。" /><StackPanel Grid.Row="2" Orientation="Horizontal"><Button AutomationProperties.Name="查看风扇安全边界" Command="{Binding ShowFanSafetyNoticeCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="查看安全边界" /><Button AutomationProperties.Name="从风扇页打开性能模式" Margin="10,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="performance" Style="{StaticResource SecondaryButtonStyle}" Content="查看性能模式" /></StackPanel></Grid>
          </Border>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
          <Grid><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition /><RowDefinition Height="42" /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="为什么没有手动风扇控制" /><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock FontSize="26" Foreground="{DynamicResource TextMutedBrush}" Text="只读设计" /><TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="23" Foreground="{DynamicResource TextSecondaryBrush}" Text="写入 EC 或厂商私有接口存在死机与硬件风险，且每台机型的寄存器定义不同。本程序坚持零写入原则，转速调整请使用机型自带的风扇模式快捷键或厂商控制中心。" /></StackPanel><Button AutomationProperties.Name="查看自动降温替代方案" Grid.Row="2" Command="{Binding NavigateCommand}" CommandParameter="performance" Style="{StaticResource SecondaryButtonStyle}" Content="了解自动降温替代方案" /></Grid>
        </Border>
      </Grid>
      <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="14,11"><TextBlock Foreground="{DynamicResource InfoTextBrush}" Text="{Binding OperationFeedback}" /></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
