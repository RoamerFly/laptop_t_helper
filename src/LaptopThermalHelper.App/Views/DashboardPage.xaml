<UserControl x:Class="LaptopThermalHelper.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LaptopThermalHelper.App.Converters"
             xmlns:views="clr-namespace:LaptopThermalHelper.App.Views">
  <UserControl.Resources>
    <converters:ThermalLevelToBrushConverter x:Key="LevelBrushConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,16,22,24">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="286" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="24,18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Width="52" Height="52" Background="{Binding Dashboard.SystemLevel, Converter={StaticResource LevelBrushConverter}}" CornerRadius="15">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="#08230D" Text="✓" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="整机状态：" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{Binding Dashboard.SystemLevel, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Dashboard.SystemStatus}" />
              </StackPanel>
              <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Dashboard.SystemMessage}" />
            </StackPanel>
          </Grid>
        </Border>
        <Button Grid.Column="1" AutomationProperties.Name="打开性能模式" Margin="16,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="performance" Style="{StaticResource ModeSummaryButtonStyle}">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="21">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{DynamicResource BlueBrush}" Text="&#xE9D2;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CoolingPolicy, StringFormat=当前策略：{0}}" />
              <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="点击查看性能模式" />
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="›" />
          </Grid>
        </Button>
      </Grid>

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <views:HardwareCardView Grid.Column="0" Height="470" DataContext="{Binding Dashboard.Cpu}" />
        <views:HardwareCardView Grid.Column="2" Height="470" DataContext="{Binding Dashboard.Gpu}" />
        <views:HardwareCardView Grid.Column="4" Height="470" DataContext="{Binding Dashboard.Storage}" />
      </Grid>

      <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}" Padding="20,16" Visibility="{Binding IsIntelGpuNoticeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="40" Height="40" Background="{DynamicResource WarningSoftBrush}" CornerRadius="20">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource WarningBrush}" Text="&#xE7BA;" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding IntelGpuNoticeTitle}" />
            <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding IntelGpuDriverStatusText}" />
          </StackPanel>
          <Button Grid.Column="2" AutomationProperties.Name="打开 Intel 驱动下载页" Command="{Binding OpenIntelDriverDownloadPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="打开下载页" Margin="0,0,10,0" Visibility="{Binding IsIntelGpuTemperatureUnsupported, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
          <Button Grid.Column="3" AutomationProperties.Name="运行内置 Intel 驱动安装器" Command="{Binding RunIntelDsaInstallerCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="一键安装驱动" Visibility="{Binding IsIntelDsaButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" MinHeight="238" Style="{StaticResource CardStyle}" Padding="18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /><RowDefinition Height="42" /></Grid.RowDefinitions>
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="整机状态" />
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Width="82" Height="82" BorderBrush="{Binding Dashboard.SystemLevel, Converter={StaticResource LevelBrushConverter}}" BorderThickness="10" CornerRadius="41" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="{Binding Dashboard.SystemLevel, Converter={StaticResource LevelBrushConverter}}" Text="✓" />
              </Border>
              <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource MetricLabelStyle}" Text="CPU 温度" /><TextBlock Grid.Column="1" Text="{Binding Dashboard.Cpu.CurrentText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Style="{StaticResource MetricLabelStyle}" Text="GPU 温度" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dashboard.Gpu.CurrentText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Style="{StaticResource MetricLabelStyle}" Text="SSD 温度" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dashboard.Storage.CurrentText}" VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0">
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Dashboard.LastUpdatedText, StringFormat=采样状态：{0}}" />
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="2" MinHeight="238" Style="{StaticResource CardStyle}" Padding="18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="30" /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="30" /></Grid.RowDefinitions>
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="温度预警" />
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="78" /><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="硬件" /><TextBlock Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" Text="当前温度" /><TextBlock Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}" Text="状态" /></Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="78" /><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock FontSize="16" Text="CPU" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Dashboard.Cpu.CurrentText}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Foreground="{Binding Dashboard.Cpu.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Dashboard.Cpu.LevelText}" VerticalAlignment="Center" /><Border Grid.Column="3" Height="8" CornerRadius="4" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#36CC88" Offset="0" /><GradientStop Color="#F2CF3A" Offset="0.42" /><GradientStop Color="#FF8A22" Offset="0.70" /><GradientStop Color="#FF3445" Offset="1" /></LinearGradientBrush></Border.Background></Border></Grid>
            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="78" /><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock FontSize="16" Text="GPU" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Dashboard.Gpu.CurrentText}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Foreground="{Binding Dashboard.Gpu.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Dashboard.Gpu.LevelText}" VerticalAlignment="Center" /><Border Grid.Column="3" Height="8" CornerRadius="4" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#36CC88" Offset="0" /><GradientStop Color="#F2CF3A" Offset="0.42" /><GradientStop Color="#FF8A22" Offset="0.70" /><GradientStop Color="#FF3445" Offset="1" /></LinearGradientBrush></Border.Background></Border></Grid>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="78" /><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock FontSize="16" Text="SSD" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Dashboard.Storage.CurrentText}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Foreground="{Binding Dashboard.Storage.Level, Converter={StaticResource LevelBrushConverter}}" Text="{Binding Dashboard.Storage.LevelText}" VerticalAlignment="Center" /><Border Grid.Column="3" Height="8" CornerRadius="4" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#36CC88" Offset="0" /><GradientStop Color="#F2CF3A" Offset="0.42" /><GradientStop Color="#FF8A22" Offset="0.70" /><GradientStop Color="#FF3445" Offset="1" /></LinearGradientBrush></Border.Background></Border></Grid>
            <TextBlock Grid.Row="5" VerticalAlignment="Bottom" Foreground="{DynamicResource TextMutedBrush}" Text="● 正常    ● 偏高    ● 过高    ● 严重过热" />
          </Grid>
        </Border>

        <Border Grid.Column="4" MinHeight="238" Style="{StaticResource CardStyle}" Padding="18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="快捷操作" />
            <StackPanel Grid.Row="1">
              <Button AutomationProperties.Name="打开温控设置" Command="{Binding NavigateCommand}" CommandParameter="settings" Style="{StaticResource QuickButtonStyle}"><Grid><TextBlock Text="⚙  打开温控设置" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid></Button>
              <Button AutomationProperties.Name="切换性能模式" Command="{Binding NavigateCommand}" CommandParameter="performance" Style="{StaticResource QuickButtonStyle}" Background="{DynamicResource PurpleSoftBrush}" BorderBrush="{DynamicResource PurpleBrush}" Foreground="{DynamicResource PurpleTextBrush}"><Grid><TextBlock Text="⚖  切换性能模式" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid></Button>
              <Button AutomationProperties.Name="导出温度日志" Command="{Binding ExportTemperatureLogCommand}" ToolTip="{Binding Dashboard.LastHistoryExportPath}" Style="{StaticResource QuickButtonStyle}" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBrush}" Foreground="{DynamicResource InfoTextBrush}"><Grid><TextBlock Text="{Binding Dashboard.HistoryExportActionText}" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid></Button>
              <Button AutomationProperties.Name="恢复默认设置" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource QuickButtonStyle}" Background="{DynamicResource CriticalSoftBrush}" BorderBrush="{DynamicResource CriticalBrush}" Foreground="{DynamicResource CriticalTextBrush}"><Grid><TextBlock Text="↶  一键恢复默认设置" /><TextBlock HorizontalAlignment="Right" Text="›" /></Grid></Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
