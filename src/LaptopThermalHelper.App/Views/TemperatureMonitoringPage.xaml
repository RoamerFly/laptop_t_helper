<UserControl x:Class="LaptopThermalHelper.App.Views.TemperatureMonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,24,24">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="154" /><ColumnDefinition Width="10" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="温度监控" />
          <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="已识别设备、主传感器和详情趋势。详情曲线当前使用 Mock 数据。" />
        </StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding TemperatureRanges}" SelectedItem="{Binding SelectedTemperatureRange, Mode=TwoWay}" Style="{StaticResource PageComboBoxStyle}" />
        <Button Grid.Column="3" AutomationProperties.Name="刷新温度详情" Command="{Binding RefreshDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="刷新详情" />
      </Grid>

      <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}" Padding="14,11">
        <TextBlock Foreground="{DynamicResource InfoTextBrush}" Text="{Binding TemperatureRangeSummary}" />
      </Border>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition /><RowDefinition Height="56" /></Grid.RowDefinitions>
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="设备树" />
            <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent" SelectedIndex="0">
              <ListBoxItem Content="▾  CPU  Intel Core i7-11800H" />
              <ListBoxItem Content="    ◉ CPU Package（主）" />
              <ListBoxItem Content="    ○ Core Max" />
              <ListBoxItem Content="▾  GPU  NVIDIA RTX 3060" />
              <ListBoxItem Content="    ◉ GPU Core（主）" />
              <ListBoxItem Content="▾  SSD  西数 SN730 1TB" />
              <ListBoxItem Content="    ◉ Composite（主）" />
            </ListBox>
            <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Text="主传感器由适配层自动选择；更改选择仅在后续版本开放。" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="34" /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="传感器读数" />
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="142" /><ColumnDefinition Width="92" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="设备" /><TextBlock Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" Text="传感器" /><TextBlock Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}" Text="角色" /><TextBlock Grid.Column="3" Foreground="{DynamicResource TextMutedBrush}" Text="当前" /><TextBlock Grid.Column="4" Foreground="{DynamicResource TextMutedBrush}" Text="最小" /><TextBlock Grid.Column="5" Foreground="{DynamicResource TextMutedBrush}" Text="最大" /><TextBlock Grid.Column="6" Foreground="{DynamicResource TextMutedBrush}" Text="平均" /></Grid>
              <ItemsControl Grid.Row="2" ItemsSource="{Binding SensorReadings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="34"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="142" /><ColumnDefinition Width="92" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding Device}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Role}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding Current}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding Minimum}" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{Binding Maximum}" VerticalAlignment="Center" /><TextBlock Grid.Column="6" Text="{Binding Average}" VerticalAlignment="Center" /></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <Border Height="248" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition /><RowDefinition Height="34" /></Grid.RowDefinitions>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="温度趋势（Mock）" />
              <Grid Grid.Row="1" Margin="4,10,4,0">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Center" />
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Top" />
                <Polyline Points="0,120 70,105 140,125 210,82 290,96 360,56 440,74 520,38 620,62 710,32" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="3" Stretch="Fill" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Text="模拟详情曲线" />
              </Grid>
              <TextBlock Grid.Row="2" Foreground="{DynamicResource TextMutedBrush}" Text="原始标识符会随传感器选择显示；未开放的风扇传感器不会伪造 0 RPM。" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
