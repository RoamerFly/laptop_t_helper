<UserControl x:Class="LaptopThermalHelper.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,24,24">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="154" /><ColumnDefinition Width="10" /><ColumnDefinition Width="120" /><ColumnDefinition Width="10" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="日志" /><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="查看本地温度历史导出与应用事件；清除仅影响当前视图。" /></StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding LogFilters}" SelectedItem="{Binding SelectedLogFilter, Mode=TwoWay}" Style="{StaticResource PageComboBoxStyle}" />
        <Button Grid.Column="3" AutomationProperties.Name="从日志页导出温度日志" Command="{Binding ExportTemperatureLogCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="导出温度日志" />
        <Button Grid.Column="5" AutomationProperties.Name="重置日志视图" Command="{Binding ClearLogViewCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="重置视图" />
      </Grid>
      <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}" Padding="14,11"><TextBlock Foreground="{DynamicResource InfoTextBrush}" Text="{Binding LogFilterSummary}" /></Border>
      <Border Style="{StaticResource CardStyle}" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="32" /><RowDefinition /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="应用事件" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="105" /><ColumnDefinition Width="72" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="时间" /><TextBlock Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" Text="类别" /><TextBlock Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}" Text="状态" /><TextBlock Grid.Column="3" Foreground="{DynamicResource TextMutedBrush}" Text="说明" /></Grid><ItemsControl Grid.Row="2" ItemsSource="{Binding ActivityLogs}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="105" /><ColumnDefinition Width="72" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Time}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Category}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource BlueBrush}" Text="{Binding Level}" /><TextBlock Grid.Column="3" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Message}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
      </Border>
      <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="温度历史 CSV" /><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="每 5 秒记录的历史数据可导出为 CSV。导出结果会显示在按钮上；没有可用数据时会给出明确状态。" /></StackPanel><StackPanel Grid.Column="1"><TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Dashboard.LastHistoryExportPath}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,9,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource InfoTextBrush}" Text="{Binding Dashboard.HistoryExportActionText}" /></StackPanel></Grid></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
