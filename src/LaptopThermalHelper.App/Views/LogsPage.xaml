<UserControl x:Class="LaptopThermalHelper.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,24,24">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="154" /><ColumnDefinition Width="10" /><ColumnDefinition Width="120" /><ColumnDefinition Width="10" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="日志" /><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="应用事件保留在当前内存视图中；清除显示不会删除磁盘日志或温度历史。" /></StackPanel>
        <ComboBox AutomationProperties.Name="日志筛选" Grid.Column="1" ItemsSource="{Binding LogFilters}" SelectedItem="{Binding SelectedLogFilter, Mode=TwoWay}" Style="{StaticResource PageComboBoxStyle}" />
        <Button Grid.Column="3" AutomationProperties.Name="导出应用事件" Command="{Binding ExportApplicationLogCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="导出应用事件" />
        <Button Grid.Column="5" AutomationProperties.Name="清除日志显示" Command="{Binding ClearLogViewCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="清除显示" />
      </Grid>
      <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}" Padding="14,11"><StackPanel><TextBlock Foreground="{DynamicResource InfoTextBrush}" Text="{Binding LogFilterSummary}" /><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ApplicationLogExportText}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="32" /><RowDefinition /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="应用事件" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="105" /><ColumnDefinition Width="72" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="时间" /><TextBlock Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" Text="类别" /><TextBlock Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}" Text="级别" /><TextBlock Grid.Column="3" Foreground="{DynamicResource TextMutedBrush}" Text="说明" /></Grid><ItemsControl Grid.Row="2" ItemsSource="{Binding ActivityLogs}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="105" /><ColumnDefinition Width="72" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Time}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Category}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource BlueBrush}" Text="{Binding Level}" /><TextBlock Grid.Column="3" Margin="0,7" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Message}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
      </Border>
      <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="温度历史 CSV" /><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="每 5 秒记录的温度历史可单独导出为 CSV。" /></StackPanel><StackPanel Grid.Column="1"><TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Dashboard.LastHistoryExportPath}" TextTrimming="CharacterEllipsis" /><Button Margin="0,9,0,0" AutomationProperties.Name="导出温度历史" Command="{Binding ExportTemperatureLogCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="导出温度日志" /></StackPanel></Grid></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
