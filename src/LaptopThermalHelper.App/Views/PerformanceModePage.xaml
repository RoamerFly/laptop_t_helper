<UserControl x:Class="LaptopThermalHelper.App.Views.PerformanceModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,24,24">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="性能模式" />
      <TextBlock Margin="0,5,0,18"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap"
                 Text="自动降温默认关闭。用户主动启用后，应用仅使用 Windows 公开的处理器电源管理能力，并在退出或恢复默认设置时恢复原始状态。" />

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Button AutomationProperties.Name="选择仅监测策略" Command="{Binding SelectCoolingPolicyCommand}" CommandParameter="仅监测" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="18" HorizontalContentAlignment="Left">
          <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="仅监测" /><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="默认策略：采集温度、保存历史并发送通知，不修改任何 Windows 电源参数。" /></StackPanel>
        </Button>
        <Button Grid.Column="2" AutomationProperties.Name="选择温和降温策略" Command="{Binding SelectCoolingPolicyCommand}" CommandParameter="温和降温" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" HorizontalContentAlignment="Left">
          <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="温和降温" /><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="达到已配置的持续高温条件后，按已保存的安全范围调整公开的处理器电源设置。" /></StackPanel>
        </Button>
        <Button Grid.Column="4" AutomationProperties.Name="选择主动降温策略" Command="{Binding SelectCoolingPolicyCommand}" CommandParameter="主动降温" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" HorizontalContentAlignment="Left">
          <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="主动降温" /><TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="持续高温时采取更保守的公开处理器电源限制；停止条件满足后会恢复原有设置。" /></StackPanel>
        </Button>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="20">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="44" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="自动降温" />
            <Grid Grid.Row="1">
              <TextBlock VerticalAlignment="Center" Text="启用自动降温" />
              <ToggleButton AutomationProperties.Name="启用性能页自动降温" HorizontalAlignment="Right" IsChecked="{Binding IsAutoCoolingEnabled, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" />
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CoolingPolicy, StringFormat=当前策略：{0}}" />
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="23" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AutoCoolingStatus}" />
            </StackPanel>
            <Button Grid.Row="4" AutomationProperties.Name="恢复默认设置" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="恢复默认设置" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition /><RowDefinition Height="36" /></Grid.RowDefinitions>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前 Windows 电源状态" />
              <StackPanel Grid.Row="1">
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PowerPlanText, StringFormat=电源计划：{0}}" />
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SystemInformationAvailabilityText}" />
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AutoCoolingStatus}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Row="2" Foreground="{DynamicResource TextMutedBrush}" Text="不使用 EC、BIOS、厂商专有接口或风扇直控。" />
            </Grid>
          </Border>
          <Border Style="{StaticResource CardStyle}" Padding="20">
            <Grid><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="最近操作" /><ItemsControl Grid.Row="1" ItemsSource="{Binding ActivityLogs}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="82" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Time}" /><TextBlock Grid.Column="1" Text="{Binding Category}" /><TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
          </Border>
        </StackPanel>
      </Grid>
      <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="14,11"><TextBlock Foreground="{DynamicResource InfoTextBrush}" Text="{Binding OperationFeedback}" /></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
