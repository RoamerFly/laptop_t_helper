<Window x:Class="LaptopThermalHelper.App.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="温度悬浮窗"
        Width="165"
        Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Window.Resources>
    <ContextMenu x:Key="FloatingMenu">
      <MenuItem Header="显示主窗口" Click="MenuShowMainWindow_Click" />
      <MenuItem Header="切换主题" Click="MenuToggleTheme_Click" />
      <Separator />
      <MenuItem Header="隐藏悬浮窗" Click="MenuHide_Click" />
      <MenuItem Header="退出" Click="MenuExit_Click" />
    </ContextMenu>
  </Window.Resources>

  <Border Margin="2"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="10,6"
          ContextMenu="{StaticResource FloatingMenu}"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25" Color="#000000" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- CPU Row -->
      <Grid Grid.Row="0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Ellipse Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Fill="{Binding Dashboard.Cpu.Level, Converter={StaticResource LevelBrushConverter}}" />
        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Text="CPU" />
        <TextBlock Grid.Column="2" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                   Text="{Binding Dashboard.Cpu.CurrentText}" />
        <TextBlock Grid.Column="3" FontSize="11" HorizontalAlignment="Right"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                   Text="{Binding Dashboard.Cpu.LoadText}" />
      </Grid>

      <!-- GPU Row -->
      <Grid Grid.Row="1" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Ellipse Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Fill="{Binding Dashboard.Gpu.Level, Converter={StaticResource LevelBrushConverter}}" />
        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Text="GPU" />
        <TextBlock Grid.Column="2" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                   Text="{Binding Dashboard.Gpu.CurrentText}" />
        <TextBlock Grid.Column="3" FontSize="11" HorizontalAlignment="Right"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                   Text="{Binding Dashboard.Gpu.LoadText}" />
      </Grid>
    </Grid>
  </Border>
</Window>
