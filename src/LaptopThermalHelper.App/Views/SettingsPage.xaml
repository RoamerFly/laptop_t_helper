<UserControl x:Class="LaptopThermalHelper.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,24,24">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="设置" />
      <TextBlock Margin="0,5,0,18" Foreground="{DynamicResource TextSecondaryBrush}" Text="设置保存在本机当前用户目录。系统更改仅在点击“保存设置”后执行；失败会保留可见提示。" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="1" /><RowDefinition Height="44" /></Grid.RowDefinitions>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="温度阈值（°C）" />
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="CPU 过高阈值" /><TextBox Grid.Column="1" Text="{Binding CpuHighThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" /></Grid>
              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="GPU 过高阈值" /><TextBox Grid.Column="1" Text="{Binding GpuHighThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" /></Grid>
              <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="SSD 过高阈值" /><TextBox Grid.Column="1" Text="{Binding StorageHighThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" /></Grid>
              <Border Grid.Row="4" Background="{DynamicResource DividerBrush}" />
              <TextBlock Grid.Row="5" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="监控状态机仍负责延迟升级和迟滞恢复。" />
            </Grid>
          </Border>
          <Border Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /></Grid.RowDefinitions>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="采样与恢复" />
              <Grid Grid.Row="1"><TextBlock VerticalAlignment="Center" Text="采样周期" /><ComboBox AutomationProperties.Name="采样周期" Width="142" HorizontalAlignment="Right" ItemsSource="{Binding SamplingIntervals}" SelectedItem="{Binding SamplingInterval, Mode=TwoWay}" Style="{StaticResource PageComboBoxStyle}" /></Grid>
              <Grid Grid.Row="2"><TextBlock VerticalAlignment="Center" Text="状态持续时间" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="20 秒（状态机默认）" /></Grid>
              <Grid Grid.Row="3"><TextBlock VerticalAlignment="Center" Text="恢复迟滞" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="3°C / 30 秒（状态机默认）" /></Grid>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /></Grid.RowDefinitions>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="通知、托盘与启动" />
              <Grid Grid.Row="1"><TextBlock VerticalAlignment="Center" Text="显示温度通知" /><ToggleButton AutomationProperties.Name="显示温度通知" HorizontalAlignment="Right" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" /></Grid>
              <Grid Grid.Row="2"><TextBlock VerticalAlignment="Center" Text="严重过热提示音" /><ToggleButton AutomationProperties.Name="严重过热提示音" HorizontalAlignment="Right" IsChecked="{Binding WarningSoundEnabled, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" /></Grid>
              <Grid Grid.Row="3"><TextBlock VerticalAlignment="Center" Text="关闭窗口时最小化到托盘" /><ToggleButton AutomationProperties.Name="关闭窗口时最小化到托盘" HorizontalAlignment="Right" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" /></Grid>
              <Grid Grid.Row="4"><TextBlock VerticalAlignment="Center" Text="当前用户开机启动" /><ToggleButton AutomationProperties.Name="当前用户开机启动" HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" /></Grid>
              <TextBlock Grid.Row="5" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding StartupStatusText}" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="应用外观" />
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="使用窗口顶部的“深色 / 浅色”按钮即时切换主题；主题切换不会影响采样、通知或电源设置。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <StackPanel Margin="0,18,0,0" Orientation="Horizontal"><Button AutomationProperties.Name="保存设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource QuickButtonStyle}" Width="140" Content="保存设置" /><Button AutomationProperties.Name="设置页恢复默认值" Margin="12,0,0,0" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="恢复默认值" /></StackPanel>
      <Border Margin="0,6,0,0" Style="{StaticResource CardStyle}" Padding="14,11"><TextBlock Foreground="{DynamicResource InfoTextBrush}" Text="{Binding OperationFeedback}" TextWrapping="Wrap" /></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
