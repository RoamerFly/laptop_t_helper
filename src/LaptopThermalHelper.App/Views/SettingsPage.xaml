<UserControl x:Class="LaptopThermalHelper.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,24,24">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="设置" />
      <TextBlock Margin="0,5,0,18" Foreground="{DynamicResource TextSecondaryBrush}" Text="以下设置保存在当前演示会话。真实配置迁移和开机启动将在后续版本完成。" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="1" /><RowDefinition Height="44" /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="温度阈值（°C）" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="CPU 过高阈值" /><TextBox Grid.Column="1" Text="{Binding CpuHighThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" /></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="GPU 过高阈值" /><TextBox Grid.Column="1" Text="{Binding GpuHighThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" /></Grid><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="SSD 过高阈值" /><TextBox Grid.Column="1" Text="{Binding StorageHighThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" /></Grid><Border Grid.Row="4" Background="{DynamicResource DividerBrush}" /><TextBlock Grid.Row="5" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="实际阈值判断仍由 Core 状态机负责。" /></Grid></Border>
          <Border Style="{StaticResource CardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="采样与恢复" /><Grid Grid.Row="1"><TextBlock VerticalAlignment="Center" Text="采样周期" /><ComboBox Width="142" HorizontalAlignment="Right" ItemsSource="{Binding SamplingIntervals}" SelectedItem="{Binding SamplingInterval, Mode=TwoWay}" Style="{StaticResource PageComboBoxStyle}" /></Grid><Grid Grid.Row="2"><TextBlock VerticalAlignment="Center" Text="状态持续时间" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="20 秒（固定）" /></Grid><Grid Grid.Row="3"><TextBlock VerticalAlignment="Center" Text="恢复迟滞" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="3°C / 30 秒（固定）" /></Grid></Grid></Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /></Grid.RowDefinitions><TextBlock FontSize="18" FontWeight="SemiBold" Text="通知与启动" /><Grid Grid.Row="1"><TextBlock VerticalAlignment="Center" Text="显示温度通知" /><ToggleButton HorizontalAlignment="Right" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" /></Grid><Grid Grid.Row="2"><TextBlock VerticalAlignment="Center" Text="严重过热提示音" /><ToggleButton HorizontalAlignment="Right" IsChecked="{Binding WarningSoundEnabled, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" /></Grid><Grid Grid.Row="3"><TextBlock VerticalAlignment="Center" Text="开机自动启动" /><ToggleButton HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" /></Grid><TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="启动项注册目前仅作安全 Mock。" /></Grid></Border>
          <Border Style="{StaticResource CardStyle}" Padding="20"><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="应用外观" /><TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="请使用窗口顶部的“深色 / 浅色”按钮即时切换主题；两种主题均保持相同布局和交互。" /></StackPanel></Border>
        </StackPanel>
      </Grid>
      <StackPanel Margin="0,18,0,0" Orientation="Horizontal"><Button AutomationProperties.Name="保存演示设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource QuickButtonStyle}" Width="140" Content="保存演示设置" /><Button AutomationProperties.Name="设置页恢复默认值" Margin="12,0,0,0" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="恢复默认值" /></StackPanel>
      <Border Margin="0,6,0,0" Style="{StaticResource CardStyle}" Padding="14,11"><TextBlock Foreground="{DynamicResource InfoTextBrush}" Text="{Binding OperationFeedback}" /></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
